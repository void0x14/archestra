    "./catalog/types": "./hey-api/clients/archestra-catalog/types.gen.ts",
    "./consts": "./consts.ts",
    "./routes": "./routes.ts",
    "./docs": "./docs.ts",
    "./e2e-test-ids": "./e2e-test-ids.ts",
    "./pagination": "./pagination.ts",
    "./permission.types": "./permission.types.ts",
    "./websocket": "./websocket.ts",
    "./utils": "./utils.ts",
    "./chat": "./chat.ts",
    "./chat-error": "./chat-error.ts",
    "./mcp-extensions": "./mcp-extensions.ts",
    "./mcp-server-config": "./mcp-server-config.ts",
    "./mcp-tool-error": "./mcp-tool-error.ts",
    "./test-mcp-server": "./test-mcp-server.ts",
