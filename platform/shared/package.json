  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "type-check": "tsgo --noEmit",
    "test": "vitest",
    "codegen:api-client": "pnpm codegen:api-client-api && pnpm codegen:api-client-catalog",
    "codegen:api-client-api": "tsx hey-api/openapi-ts-api.ts && biome check --write ./hey-api/clients/api",
    "codegen:api-client-catalog": "tsx hey-api/openapi-ts-catalog.ts && biome check --write ./hey-api/clients/archestra-catalog",
    "codegen:theme-css": "tsx ./themes/generate-theme-css.ts",
    "codegen": "pnpm codegen:api-client && pnpm codegen:theme-css",
    "check:ci": "concurrently --kill-others-on-fail --group --names type-check,test,knip,biome 'pnpm type-check' 'pnpm test' 'pnpm knip' 'biome ci'",
    "check:commit": "concurrently --kill-others-on-fail --group --names type-check,knip,biome 'pnpm type-check' 'pnpm knip' 'biome ci'",
    "knip": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
