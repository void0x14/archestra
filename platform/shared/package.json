    "@hey-api/openapi-ts": "^0.94.0",
    "@types/node": "^25",
    "@typescript/native-preview": "catalog:",
    "knip": "^5.85.0",
    "typescript": "catalog:",
    "vitest": "^4.1.0"
  }
}
